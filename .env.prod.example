# Production settings for docker-compose.prod.yml. Copy to .env.prod on the server only
# and fill in every value. .env.prod is git-ignored; never commit it.

# Public address (no https://, no trailing slash) and the image to run
DOMAIN=hatua.example.com
API_IMAGE=ACCOUNT_ID.dkr.ecr.eu-north-1.amazonaws.com/hatua-api:latest

# Amazon RDS PostgreSQL. sslmode=require encrypts the connection.
DATABASE_URL=postgresql+psycopg://hatua:CHANGE_ME@RDS_ENDPOINT:5432/hatua?sslmode=require

# Make with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_HOURS=12

DEV_MODE=false
CORS_ORIGINS=https://hatua.example.com
PUBLIC_BASE_URL=https://hatua.example.com

# Google sign-in: the OAuth Web application client ID (comma-separated if several)
GOOGLE_CLIENT_IDS=

# Email for verification and password reset links (Gmail app password works)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Hatua <you@gmail.com>
