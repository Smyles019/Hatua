# Copy to backend/.env and adjust. backend/.env is git-ignored; never commit it.
# Values below match docker-compose.yml (local development only).
DATABASE_URL=postgresql+psycopg://hatua:hatua_dev_password@localhost:5432/hatua
TEST_DATABASE_URL=postgresql+psycopg://hatua:hatua_dev_password@localhost:5432/hatua_test

# Signs access tokens. With DEV_MODE=false the API refuses to start unless this is a
# random string of 32 or more characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_HOURS=12

MODEL_DIR=ml/artefacts
MODEL_RELEASE=1.1.0
# Under-24 model folder (made by the under-24 steps in the README). If it is missing,
# 4-23 months fall back to the WHO motor milestone check.
UNDER2_MODEL_DIR=ml/artefacts/xgboost_under2/short_30

# true only on your own machine: serves the test UI at / and /dev/admin-session, which
# hands out an administrator session to anyone who asks.
DEV_MODE=true
CORS_ORIGINS=*

# Email (confirmation and password reset links), sent through Gmail.
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Make an app password at https://myaccount.google.com/apppasswords
# 3. Fill in the address and app password below, then remove the # in front of
#    the five lines. While SMTP_HOST is unset, emails are only written to the log.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=the16letterapppassword
# MAIL_FROM=Hatua <your.address@gmail.com>
# Links in emails point here. localhost only opens on this laptop; for a phone use
# the laptop's address on the same Wi-Fi, for example http://192.168.1.20:8000
PUBLIC_BASE_URL=http://localhost:8000
